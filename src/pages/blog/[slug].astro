---
import { Temporal } from "temporal-polyfill-lite";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSlug, getState } from "./_functions";
import Img from "@/components/Img.astro";
import A from "@/components/A.astro";
import { dateToZonedDateTime, isoStringToZonedDateTime, toJpDateString } from "@/utils/Date.mjs";
export async function getStaticPaths() {
    const blogEntries = await getCollection("blog", post => {
        return import.meta.env.DEV || getState(post) == "published";
    });
    return blogEntries.map(entry => ({
        params: { slug: getSlug(entry) },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const publish = dateToZonedDateTime(entry.data.publishDate);
const lastUpdate = await (async () => {
    const lastUpdateISO = await Bun.$`git log -1 --format="%ad" --date="iso" ./src/content/${entry.collection}/${entry.id}`.text();
    return lastUpdateISO.length != 0 ? isoStringToZonedDateTime(lastUpdateISO) : undefined;
})();

const lastUpdateString = (() => {
    if (!lastUpdate || Temporal.ZonedDateTime.compare(lastUpdate, publish) < 0) {
        return undefined;
    }
    const string = toJpDateString(lastUpdate);
    if (publish.year != lastUpdate.year) {
        return string;
    }
    if (publish.month != lastUpdate.month) {
        return string.slice(5, 11);
    }
    if (publish.day != lastUpdate.day) {
        return string.slice(8, 11);
    }
    return undefined;
})();
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
    <div class="publishDate">
        <time datetime={publish.toString()}>{toJpDateString(publish)}</time>
        {
            lastUpdateString && (
                <>
                    (最終更新: <time datetime={lastUpdate!.toString()}>{lastUpdateString}</time>)
                </>
            )
        }
    </div>
    <Content components={{ a: A, img: Img }} />
</BaseLayout>
<style>
    div.publishDate {
        margin-top: calc(-1 * var(--gap));
        color: var(--sub-color);
    }
</style>
