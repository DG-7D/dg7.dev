---
import BaseLayout from "@/layouts/BaseLayout.astro";
// TODO: 自動取得する
const pages = [
    { title: "ゴヴィッショヌ揃え", url: "govissionu/", description: "ゴヴィッショヌ揃えをJavaScriptで実装してみた。" },
    { title: "ゆいのだじゃれデータベース", url: "yuino-dajare/", description: "ゆいのだじゃれデータベースのツイートを一覧表示します。" },
    { title: "Webカメラ照準器", url: "sight/", description: "スマホなどを照準器にできるWebアプリです。" },
    { title: "Webカメラテストページ", url: "web-camera-test/", description: "Webカメラ映像取得のパラメータをいろいろいじるページです。" },
    { title: "数学用英数字記号変換器", url: "math-converter/", description: "通常のASCII英数字列から数学用英数字記号を生成するツールです。" },
    { title: "コードポイントから文字に変換するやつ", url: "alt-x/", description: "入力したUnicodeコードポイントに対応する文字を表示するツールです。" },
];
---

<BaseLayout title="その他" description="その他のWebアプリなどのページの一覧です。">
    <p>そのほかの作ったWebアプリとかの一覧です。</p>
    <dl>
        {
            pages.map(page => (
                <>
                    <dt>
                        <a href={page.url}>{page.title}</a>
                    </dt>
                    <dd>{page.description}</dd>
                </>
            ))
        }
    </dl>
</BaseLayout>
