---
import "@/styles/style.css";
import Head from "@/components/Head.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
const siteName = "あづみのメモ帳";

interface Props {
    title: string;
    summaryLargeImage?: boolean;
    ogImage?: string;
    description: string;
}

const title = Astro.props.title == "" ? undefined : Astro.props.title;
---

<!doctype html>
<html lang="ja">
    <Head {...Astro.props}>
        {Astro.url.pathname.startsWith("/blog/") && <link rel="alternate" type="application/rss+xml" title="あづみのブログ – あづみのメモ帳" href="/blog/rss.xml" />}
    </Head>
    <body>
        <Header />
        <main>
            <Breadcrumb />
            <h1 style={!title && { display: "none" }}>{title ?? siteName}</h1>
            {!title && <div /> /* gap分余白追加 */}
            <slot />
        </main>
        <Footer />
    </body>
</html>
