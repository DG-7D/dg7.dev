---
import { Temporal } from "temporal-polyfill-lite";
import { isoStringToJSTDateTime, toJpDateString } from "@/utils/Date.mjs";

interface Props {
    count: number;
    inline?: boolean;
}

const separator = "\uF8FF";
const commits: { date: Temporal.PlainDate; messages: string[] }[] = [];
let overflow = false;
let lastDate = new Temporal.PlainDate(2000, 1, 1);
let currentMessages: string[] = [];
for await (const line of Bun.$`git log --format=%ad${separator}%s --date=iso-strict --first-parent`.lines()) {
    const [isoDateTime, message] = line.split(separator);
    if (isoDateTime && message && !message.startsWith("_") && !message.startsWith("Merge")) {
        const date = isoStringToJSTDateTime(isoDateTime).toPlainDate();
        if (!date.equals(lastDate)) {
            if (commits.length === Astro.props.count) {
                overflow = true;
                break;
            }

            currentMessages = [];
            commits.push({ date: date, messages: currentMessages });
        }
        lastDate = date;

        currentMessages.push(message);
    }
}
---

<dl class={Astro.props.inline ? "inline" : ""}>
    {
        commits.map(({ date, messages }) => (
            <>
                <dt>
                    <time datetime={date.toString()}>{toJpDateString(date)}</time>
                </dt>
                {messages.map(message => (
                    <dd>{message}</dd>
                ))}
            </>
        ))
    }
    {
        overflow && (
            <>
                <dt>それ以前</dt>
                <dd>
                    <a href="/changes/">もっと見る</a>
                </dd>
            </>
        )
    }
</dl>
