---
import { Temporal } from "temporal-polyfill-lite";
import "@/styles/style.css";
const copylightYear: string = Temporal.Now.zonedDateTimeISO("Asia/Tokyo").year.toString();
---

<footer><a href="/about/"><div>© {copylightYear} あづみ</div></a></footer>
<style>
    a {
        width: 100%;
        display: block;
        background-color: var(--theme-color);
        color: var(--bwhite);
        padding: 0.25rem;
        text-align: center;
        align-content: center;
    }
</style>
