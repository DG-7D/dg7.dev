---
interface Props {
    href: string;
    title?: string;
}

const external = Astro.props.href.includes("//");

if (external && new URL(Astro.props.href).hostname === "x.com") {
    Astro.props.href = Astro.props.href.replace("x.com", "twitter.com");
}
---

<a href={Astro.props.href} target={external ? "_blank" : undefined} title={Astro.props.title} referrerpolicy="strict-origin-when-cross-origin"><slot /></a>
